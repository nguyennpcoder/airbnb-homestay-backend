# Copy thành biến môi trường trong IntelliJ Run Configuration hoặc export trước khi chạy:
#   export $(grep -v '^#' .env | xargs) && ./mvnw spring-boot:run

DB_HOST=localhost
DB_PORT=3307
DB_NAME=airbnb_homestay
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

SERVER_PORT=8089

# --- Gmail gửi OTP thật (bắt buộc App Password, KHÔNG dùng mật khẩu đăng nhập thường) ---
# https://myaccount.google.com/apppasswords
# Port 465 (SSL) — Render blocks outbound 587. Use 465 for Gmail.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=your.email@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx

MAIL_ENABLED=true
DEBUG_EXPOSE_OTP=false

# --- Resend API (dùng trên Render vì SMTP bị chặn) ---
# Đăng ký free tại https://resend.com → lấy API key
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=onboarding@resend.dev

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8089
